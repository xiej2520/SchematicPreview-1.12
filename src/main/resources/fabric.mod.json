{
    "schemaVersion": 1,
    "id": "schematicpreview",
    "name": "SchematicPreview",
    "version": "${mod_version}",
    "description": "Schematic previews and browser utilities for Litematica",
    "license": "LGPLv3",
    "authors": [ "froyln" ],
    "environment": "client",
    "entrypoints": {
        "client-init": [
            "dev.froyln.schematicpreview.SchematicPreview"
        ]
    },
    "mixins": [
        {
            "config": "mixins.schematicpreview.json",
            "environment": "client"
        }
    ],
    "depends": {
        "minecraft": "1.12.x",
        "malilib": ">=0.60.2-xiej.8",
        "litematica": ">=0.40.1-xiej.2",
        "osl-entrypoints": "*",
        "osl-lifecycle-events": "*",
        "osl-resource-loader": "*"
    }
}
